rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function accessPath(studyId) {
      return /databases/(default)/documents/studies/$(studyId)/access/members;
    }

    function accessData(studyId) {
      return firestore.get(accessPath(studyId)).data;
    }

    function inStudy(studyId) {
      return signedIn()
        && firestore.exists(accessPath(studyId))
        && (
          accessData(studyId).hostId == request.auth.uid
          || (
            accessData(studyId).approvedUserIds is list
            && accessData(studyId).approvedUserIds.hasAny([request.auth.uid])
          )
        );
    }

    function isHost(studyId) {
      return signedIn()
        && firestore.exists(accessPath(studyId))
        && accessData(studyId).hostId == request.auth.uid;
    }

    function isManagerEditor(studyId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/studies/$(studyId)/managers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/studies/$(studyId)/managers/$(request.auth.uid)).data.permissions.canEdit == true;
    }

    function imageFile() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('image/.*');
    }

    function isJpeg() {
      return request.resource.contentType is string
        && request.resource.contentType.matches('image/.*');
    }

    function isPlainText() {
      return request.resource.contentType is string
        && request.resource.contentType.matches('text/plain.*');
    }

    function isAudio() {
      return request.resource.contentType is string
        && request.resource.contentType.matches('audio/.*');
    }

    match /avatars/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == uid
        && imageFile();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /sessions/{studyId}/{date} {
      allow read: if inStudy(studyId);

      match /{fileName} {
        allow read: if inStudy(studyId);
        allow create: if (isHost(studyId) || isManagerEditor(studyId))
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (
            (
              fileName.matches('^[A-Za-z0-9]+-[0-9]+\\.jpg$')
              && request.resource.size < 5 * 1024 * 1024
              && isJpeg()
            )
            || (
              fileName.matches('^[A-Za-z0-9]+-[0-9]+\\.txt$')
              && request.resource.size < 1024 * 1024
              && isPlainText()
            )
            || (
              fileName.matches('^[A-Za-z0-9]+-[0-9]+\\.(webm|m4a|mp3|ogg|wav)$')
              && request.resource.size < 32 * 1024 * 1024
              && isAudio()
            )
          );
        allow delete: if isHost(studyId) || isManagerEditor(studyId);
      }
    }
  }
}
