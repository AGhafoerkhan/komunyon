{
  "name": "komunyon",
  "version": "0.1.0",
  "private": false,
  "description": "Host and join Bible studies and communion groups in The Hague.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:cards": "playwright test",
    "test:e2e": "node scripts/test-e2e-emulator.mjs",
    "test:security": "firebase emulators:exec --only auth,firestore,functions,storage --project demo-komunyon \"vitest run tests/security\""
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "firebase-tools": "^15.37.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
