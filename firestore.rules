rules_version = '2';

// Komunyon — The Hague Bible studies.
// Public study documents never store a street address.
// studies/{studyId}/private/details holds exactAddress + entryNotes
// and is readable only by the host and approvedUserIds.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function studyPath(studyId) {
      return /databases/$(database)/documents/studies/$(studyId);
    }

    function studyExists(studyId) {
      return exists(studyPath(studyId));
    }

    function studyDoc(studyId) {
      return get(studyPath(studyId)).data;
    }

    function studyIsListed(study) {
      return !study.keys().hasAny(['isPublic']) || study.isPublic == true;
    }

    function isUidOn(study, field) {
      return study.keys().hasAny([field])
        && study[field] is list
        && study[field].hasAny([request.auth.uid]);
    }

    function canReadPrivate(study) {
      return signedIn()
        && (
          study.hostId == request.auth.uid
          || (
            study.approvedUserIds is list
            && study.approvedUserIds.hasAny([request.auth.uid])
          )
        );
    }

    function isHagueArea(area) {
      return area in [
        'Centrum',
        'Scheveningen',
        'Statenkwartier',
        'Duinoord',
        'Zeeheldenkwartier',
        'Archipelbuurt',
        'Bezuidenhout',
        'Mariahoeve',
        'Haagse Hout',
        'Segbroek',
        'Regentessekwartier',
        'Transvaalkwartier',
        'Schildersbuurt',
        'Laak',
        'Binckhorst',
        'Escamp',
        'Moerwijk',
        'Loosduinen',
        'Ypenburg',
        'Leidschenveen'
      ];
    }

    function publicStudyKeys() {
      return [
        'hostId',
        'hostName',
        'hostAge',
        'hostPhotoURL',
        'title',
        'description',
        'tags',
        'format',
        'dayOfWeek',
        'date',
        'time',
        'maxCapacity',
        'area',
        'isPublic',
        'pendingUserIds',
        'approvedUserIds',
        'invitedUserIds',
        'skippedDates',
        'createdAt',
        'updatedAt'
      ];
    }

    function validSchedule(data) {
      return (
          data.format == 'recurring'
          && data.dayOfWeek is int
          && data.dayOfWeek >= 0
          && data.dayOfWeek <= 6
          && data.date == null
        )
        || (
          data.format == 'one-off'
          && data.date is string
          && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.dayOfWeek == null
        );
    }

    function validTagList(tags) {
      return tags is list
        && tags.size() >= 1
        && tags.size() <= 4
        && tags.size() == tags.toSet().size()
        && tags.hasOnly(['bible-study', 'prayer', 'worship', 'communion']);
    }

    // Studies created before tags exist may omit the field. New writes must send a real list.
    function validTags(data) {
      return !data.keys().hasAny(['tags']) || validTagList(data.tags);
    }

    function isSkippedDate(value) {
      return value is string
        && value.size() == 10
        && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validSkippedDates(data) {
      return !data.keys().hasAny(['skippedDates'])
        || (
          data.skippedDates is list
          && data.skippedDates.size() <= 8
          && data.skippedDates.size() == data.skippedDates.toSet().size()
          && (data.format == 'recurring' || data.skippedDates.size() == 0)
          && (data.skippedDates.size() < 1 || isSkippedDate(data.skippedDates[0]))
          && (data.skippedDates.size() < 2 || isSkippedDate(data.skippedDates[1]))
          && (data.skippedDates.size() < 3 || isSkippedDate(data.skippedDates[2]))
          && (data.skippedDates.size() < 4 || isSkippedDate(data.skippedDates[3]))
          && (data.skippedDates.size() < 5 || isSkippedDate(data.skippedDates[4]))
          && (data.skippedDates.size() < 6 || isSkippedDate(data.skippedDates[5]))
          && (data.skippedDates.size() < 7 || isSkippedDate(data.skippedDates[6]))
          && (data.skippedDates.size() < 8 || isSkippedDate(data.skippedDates[7]))
        );
    }

    function validPublicStudy(data) {
      return data.keys().hasOnly(publicStudyKeys())
        && data.hostId is string
        && data.hostName is string
        && data.hostName.size() > 0
        && data.hostName.size() <= 80
        && data.hostAge is int
        && data.hostAge >= 1
        && data.hostAge <= 120
        && validPhoto(data.hostPhotoURL)
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && validTags(data)
        && data.format in ['recurring', 'one-off']
        && validSchedule(data)
        && data.time is string
        && data.time.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.maxCapacity is int
        && data.maxCapacity >= 1
        && data.maxCapacity <= 100
        && data.area is string
        && isHagueArea(data.area)
        && (!data.keys().hasAny(['isPublic']) || data.isPublic is bool)
        && data.pendingUserIds is list
        && data.pendingUserIds.size() <= 200
        && data.approvedUserIds is list
        && data.approvedUserIds.size() <= data.maxCapacity
        && (!data.keys().hasAny(['invitedUserIds']) || (
          data.invitedUserIds is list
          && data.invitedUserIds.size() <= 40
        ))
        && validSkippedDates(data)
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function isHost() {
      return signedIn() && request.auth.uid == resource.data.hostId;
    }

    function hostPreserved() {
      return request.resource.data.hostId == resource.data.hostId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // New list contains every previous uid plus exactly one: the caller.
    function selfAddedTo(previous, next) {
      return previous is list
        && next is list
        && !previous.hasAny([request.auth.uid])
        && next.hasAny([request.auth.uid])
        && next.hasAll(previous)
        && next.size() == previous.size() + 1;
    }

    // New list is the previous list minus exactly the caller.
    function selfRemovedFrom(previous, next) {
      return previous is list
        && next is list
        && previous.hasAny([request.auth.uid])
        && !next.hasAny([request.auth.uid])
        && previous.hasAll(next)
        && previous.size() == next.size() + 1;
    }

    function onlyTouched(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function selfRequestsToJoin() {
      return signedIn()
        && request.auth.uid != resource.data.hostId
        && !resource.data.approvedUserIds.hasAny([request.auth.uid])
        && resource.data.approvedUserIds.size() < resource.data.maxCapacity
        && onlyTouched(['pendingUserIds', 'updatedAt'])
        && selfAddedTo(resource.data.pendingUserIds, request.resource.data.pendingUserIds)
        && validPublicStudy(request.resource.data);
    }

    function selfCancelsRequest() {
      return signedIn()
        && onlyTouched(['pendingUserIds', 'updatedAt'])
        && selfRemovedFrom(resource.data.pendingUserIds, request.resource.data.pendingUserIds)
        && validPublicStudy(request.resource.data);
    }

    function selfLeavesGroup() {
      return signedIn()
        && request.auth.uid != resource.data.hostId
        && onlyTouched(['approvedUserIds', 'updatedAt'])
        && selfRemovedFrom(resource.data.approvedUserIds, request.resource.data.approvedUserIds)
        && validPublicStudy(request.resource.data);
    }

    function selfAcceptsInvite() {
      return signedIn()
        && request.auth.uid != resource.data.hostId
        && isUidOn(resource.data, 'invitedUserIds')
        && resource.data.approvedUserIds.size() < resource.data.maxCapacity
        && selfRemovedFrom(resource.data.invitedUserIds, request.resource.data.invitedUserIds)
        && selfAddedTo(resource.data.approvedUserIds, request.resource.data.approvedUserIds)
        && (
          onlyTouched(['invitedUserIds', 'approvedUserIds', 'updatedAt'])
          || (
            onlyTouched(['invitedUserIds', 'approvedUserIds', 'pendingUserIds', 'updatedAt'])
            && selfRemovedFrom(resource.data.pendingUserIds, request.resource.data.pendingUserIds)
          )
        )
        && validPublicStudy(request.resource.data);
    }

    function selfDeclinesInvite() {
      return signedIn()
        && isUidOn(resource.data, 'invitedUserIds')
        && onlyTouched(['invitedUserIds', 'updatedAt'])
        && selfRemovedFrom(resource.data.invitedUserIds, request.resource.data.invitedUserIds)
        && validPublicStudy(request.resource.data);
    }

    function profileKeys() {
      return [
        'uid',
        'email',
        'fullName',
        'nameTokens',
        'age',
        'photoURL',
        'bio',
        'country',
        'city',
        'neighbourhood',
        'phone',
        'profileCompleted',
        'createdAt',
        'updatedAt'
      ];
    }

    function validPhoto(url) {
      return url is string && (
        url.size() == 0
        || (url.size() <= 2000 && url.matches('^https://.+'))
        || (
          url.size() <= 24000
          && url.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        )
      );
    }

    function emailOk(data) {
      return data.email is string
        && data.email.size() <= 200
        && (
          request.auth.token.email == null
          || data.email == request.auth.token.email
        );
    }

    function placeOk(data, required) {
      return (!data.keys().hasAny(['country']) || (data.country is string && data.country.size() <= 60))
        && (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() <= 80))
        && (!data.keys().hasAny(['neighbourhood']) || (data.neighbourhood is string && data.neighbourhood.size() <= 80))
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 16))
        && (
          !required
          || (
            data.country is string
            && data.country.size() >= 2
            && data.city is string
            && data.city.size() >= 2
            && data.neighbourhood is string
            && (data.city != 'The Hague' || isHagueArea(data.neighbourhood))
            && data.phone is string
            && data.phone.matches('^\\+?[0-9]{8,15}$')
            && data.photoURL is string
            && data.photoURL.size() > 0
          )
        );
    }

    function profileComplete(data) {
      return data.profileCompleted == true
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 80
        && data.age is int
        && data.age >= 1
        && data.age <= 120
        && validPhoto(data.photoURL)
        && data.bio is string
        && data.bio.size() <= 800
        && placeOk(data, true);
    }

    function profileIncomplete(data) {
      return data.profileCompleted == false
        && data.fullName is string
        && data.fullName.size() <= 80
        && data.age is int
        && data.age >= 0
        && data.age <= 120
        && validPhoto(data.photoURL)
        && data.bio is string
        && data.bio.size() <= 800
        && placeOk(data, false);
    }

    function validNameTokens(data) {
      return !data.keys().hasAny(['nameTokens'])
        || (data.nameTokens is list && data.nameTokens.size() <= 120);
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly(profileKeys())
        && request.resource.data.uid == uid
        && emailOk(request.resource.data)
        && validNameTokens(request.resource.data)
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40
        && (
          profileComplete(request.resource.data)
          || profileIncomplete(request.resource.data)
        );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validProfile(uid);
      allow update: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    match /studies/{studyId} {
      allow get: if true;

      allow list: if studyIsListed(resource.data)
        || (
          signedIn()
          && (
            resource.data.hostId == request.auth.uid
            || isUidOn(resource.data, 'invitedUserIds')
            || isUidOn(resource.data, 'approvedUserIds')
            || isUidOn(resource.data, 'pendingUserIds')
          )
        );

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.isPublic is bool
        && request.resource.data.invitedUserIds is list
        && request.resource.data.invitedUserIds.size() == 0
        && validPublicStudy(request.resource.data)
        && validTagList(request.resource.data.tags)
        && request.resource.data.pendingUserIds.size() == 0
        && request.resource.data.approvedUserIds.size() == 0;

      allow update: if (
          isHost()
          && hostPreserved()
          && validPublicStudy(request.resource.data)
        )
        || selfRequestsToJoin()
        || selfCancelsRequest()
        || selfLeavesGroup()
        || selfAcceptsInvite()
        || selfDeclinesInvite()
        || (
          signedIn()
          && !resource.data.keys().hasAny(['isPublic'])
          && onlyTouched(['isPublic'])
          && request.resource.data.isPublic == true
          && validPublicStudy(request.resource.data)
        );

      allow delete: if isHost();

      match /private/details {
        allow read: if studyExists(studyId) && canReadPrivate(studyDoc(studyId));

        allow create, update: if studyExists(studyId)
          && signedIn()
          && studyDoc(studyId).hostId == request.auth.uid
          && request.resource.data.keys().hasOnly(['exactAddress', 'entryNotes', 'updatedAt'])
          && request.resource.data.exactAddress is string
          && request.resource.data.exactAddress.size() > 0
          && request.resource.data.exactAddress.size() <= 180
          && request.resource.data.entryNotes is string
          && request.resource.data.entryNotes.size() <= 1000
          && request.resource.data.updatedAt is string;

        allow delete: if studyExists(studyId)
          && signedIn()
          && studyDoc(studyId).hostId == request.auth.uid;
      }

      match /notices/{uid} {
        allow read: if signedIn() && resource.data.userId == request.auth.uid;

        allow read: if studyExists(studyId)
          && signedIn()
          && studyDoc(studyId).hostId == request.auth.uid;

        allow create, update: if (
            studyExists(studyId)
            && signedIn()
            && uid == request.auth.uid
            && studyDoc(studyId).hostId != request.auth.uid
            && request.resource.data.keys().hasOnly(['type', 'userId', 'createdAt'])
            && (
              (
                request.resource.data.type == 'left'
                && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
              )
              || (
                request.resource.data.type == 'cancelled'
                && studyDoc(studyId).pendingUserIds.hasAny([request.auth.uid])
              )
              || (
                (request.resource.data.type == 'accepted' || request.resource.data.type == 'declined')
                && studyDoc(studyId).keys().hasAny(['invitedUserIds'])
                && studyDoc(studyId).invitedUserIds.hasAny([request.auth.uid])
              )
            )
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() <= 40
          )
          || (
            studyExists(studyId)
            && signedIn()
            && studyDoc(studyId).hostId == request.auth.uid
            && uid != request.auth.uid
            && studyDoc(studyId).approvedUserIds.hasAny([uid])
            && request.resource.data.keys().hasOnly(['type', 'userId', 'createdAt', 'studyTitle', 'hostName'])
            && request.resource.data.type == 'removed'
            && request.resource.data.userId == uid
            && request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() <= 40
            && request.resource.data.studyTitle is string
            && request.resource.data.studyTitle.size() > 0
            && request.resource.data.studyTitle.size() <= 120
            && request.resource.data.hostName is string
            && request.resource.data.hostName.size() > 0
            && request.resource.data.hostName.size() <= 80
          );

        allow delete: if studyExists(studyId)
          && signedIn()
          && (
            studyDoc(studyId).hostId == request.auth.uid
            || request.auth.uid == uid
          );
      }
    }
  }
}
