rules_version = '2';

// Komunyon — The Hague Bible studies.
// Public study documents never store a street address.
// studies/{studyId}/private/details holds exactAddress + entryNotes
// and is readable only by the host and approvedUserIds.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function studyPath(studyId) {
      return /databases/$(database)/documents/studies/$(studyId);
    }

    function profileContactPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/private/contact;
    }

    function hasCompletePrivateContact(uid) {
      return exists(profileContactPath(uid))
        && get(profileContactPath(uid)).data.phone is string
        && get(profileContactPath(uid)).data.phone.matches('^\\+?[0-9]{8,15}$')
        && get(profileContactPath(uid)).data.country is string
        && get(profileContactPath(uid)).data.country.size() >= 2
        && get(profileContactPath(uid)).data.city is string
        && get(profileContactPath(uid)).data.city.size() >= 2
        && get(profileContactPath(uid)).data.neighbourhood is string
        && get(profileContactPath(uid)).data.neighbourhood.size() >= 2;
    }

    function studyExists(studyId) {
      return exists(studyPath(studyId));
    }

    function studyDoc(studyId) {
      return get(studyPath(studyId)).data;
    }

    function studyIsListed(study) {
      return !study.keys().hasAny(['isPublic']) || study.isPublic == true;
    }

    function isUidOn(study, field) {
      return study.keys().hasAny([field])
        && study[field] is list
        && study[field].hasAny([request.auth.uid]);
    }

    function canReadStudy(study) {
      return signedIn()
        && (
          studyIsListed(study)
          || study.hostId == request.auth.uid
          || isUidOn(study, 'invitedUserIds')
          || isUidOn(study, 'approvedUserIds')
          || isUidOn(study, 'pendingUserIds')
        );
    }

    function canReadPrivate(study) {
      return signedIn()
        && (
          study.hostId == request.auth.uid
          || (
            study.approvedUserIds is list
            && study.approvedUserIds.hasAny([request.auth.uid])
          )
        );
    }

    function canSeeGroupContact(studyId, uid) {
      return signedIn()
        && studyExists(studyId)
        && (!studyDoc(studyId).keys().hasAny(['showMemberContacts']) || studyDoc(studyId).showMemberContacts == true)
        && (
          studyDoc(studyId).hostId == request.auth.uid
          || studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
        )
        && (
          studyDoc(studyId).hostId == uid
          || studyDoc(studyId).approvedUserIds.hasAny([uid])
        );
    }

    function isHagueArea(area) {
      return area in [
        'Centrum',
        'Scheveningen',
        'Statenkwartier',
        'Duinoord',
        'Zeeheldenkwartier',
        'Archipelbuurt',
        'Bezuidenhout',
        'Mariahoeve',
        'Haagse Hout',
        'Segbroek',
        'Regentessekwartier',
        'Transvaalkwartier',
        'Schildersbuurt',
        'Laak',
        'Binckhorst',
        'Escamp',
        'Moerwijk',
        'Loosduinen',
        'Ypenburg',
        'Leidschenveen'
      ];
    }

    function publicStudyKeys() {
      return [
        'hostId',
        'hostName',
        'hostAge',
        'hostPhotoURL',
        'title',
        'description',
        'tags',
        'format',
        'dayOfWeek',
        'date',
        'time',
        'maxCapacity',
        'area',
        'isPublic',
        'showMemberContacts',
        'pendingUserIds',
        'approvedUserIds',
        'invitedUserIds',
        'skippedDates',
        'createdAt',
        'updatedAt'
      ];
    }

    function validSchedule(data) {
      return (
          data.format == 'recurring'
          && data.dayOfWeek is int
          && data.dayOfWeek >= 0
          && data.dayOfWeek <= 6
          && data.date == null
        )
        || (
          data.format == 'one-off'
          && data.date is string
          && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.dayOfWeek == null
        );
    }

    function validTagList(tags) {
      return tags is list
        && tags.size() >= 1
        && tags.size() <= 4
        && tags.size() == tags.toSet().size()
        && tags.hasOnly(['bible-study', 'prayer', 'worship', 'prayer-worship', 'communion', 'event', 'dinner']);
    }

    // Studies created before tags exist may omit the field. New writes must send a real list.
    function validTags(data) {
      return !data.keys().hasAny(['tags']) || validTagList(data.tags);
    }

    function isSkippedDate(value) {
      return value is string
        && value.size() == 10
        && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validSkippedDates(data) {
      return !data.keys().hasAny(['skippedDates'])
        || (
          data.skippedDates is list
          && data.skippedDates.size() <= 8
          && data.skippedDates.size() == data.skippedDates.toSet().size()
          && (data.format == 'recurring' || data.skippedDates.size() == 0)
          && (data.skippedDates.size() < 1 || isSkippedDate(data.skippedDates[0]))
          && (data.skippedDates.size() < 2 || isSkippedDate(data.skippedDates[1]))
          && (data.skippedDates.size() < 3 || isSkippedDate(data.skippedDates[2]))
          && (data.skippedDates.size() < 4 || isSkippedDate(data.skippedDates[3]))
          && (data.skippedDates.size() < 5 || isSkippedDate(data.skippedDates[4]))
          && (data.skippedDates.size() < 6 || isSkippedDate(data.skippedDates[5]))
          && (data.skippedDates.size() < 7 || isSkippedDate(data.skippedDates[6]))
          && (data.skippedDates.size() < 8 || isSkippedDate(data.skippedDates[7]))
        );
    }

    function validPublicStudy(data) {
      return data.keys().hasOnly(publicStudyKeys())
        && data.hostId is string
        && data.hostName is string
        && data.hostName.size() > 0
        && data.hostName.size() <= 80
        && data.hostAge is int
        && data.hostAge >= 1
        && data.hostAge <= 120
        && validPhoto(data.hostPhotoURL)
        && data.title is string
        && data.title.size() >= 6
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() >= 12
        && data.description.size() <= 2000
        && validTags(data)
        && data.format in ['recurring', 'one-off']
        && validSchedule(data)
        && data.time is string
        && data.time.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.maxCapacity is int
        && data.maxCapacity >= 1
        && data.maxCapacity <= 100
        && data.area is string
        && isHagueArea(data.area)
        && (!data.keys().hasAny(['isPublic']) || data.isPublic is bool)
        && (!data.keys().hasAny(['showMemberContacts']) || data.showMemberContacts is bool)
        && data.pendingUserIds is list
        && data.pendingUserIds.size() <= 200
        && data.pendingUserIds.size() == data.pendingUserIds.toSet().size()
        && data.approvedUserIds is list
        && data.approvedUserIds.size() == data.approvedUserIds.toSet().size()
        && (!data.keys().hasAny(['invitedUserIds']) || (
          data.invitedUserIds is list
          && data.invitedUserIds.size() <= 40
          && data.invitedUserIds.size() == data.invitedUserIds.toSet().size()
        ))
        && validSkippedDates(data)
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    function validStudyUpdate(data) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return data.keys().hasOnly(publicStudyKeys())
        && data.hostId == resource.data.hostId
        && data.createdAt == resource.data.createdAt
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && (!changed.hasAny(['hostName']) || (data.hostName is string && data.hostName.size() > 0 && data.hostName.size() <= 80))
        && (!changed.hasAny(['hostAge']) || (data.hostAge is int && data.hostAge >= 1 && data.hostAge <= 120))
        && (!changed.hasAny(['hostPhotoURL']) || validPhoto(data.hostPhotoURL))
        && (!changed.hasAny(['title']) || (data.title is string && data.title.size() >= 6 && data.title.size() <= 120))
        && (!changed.hasAny(['description']) || (data.description is string && data.description.size() >= 12 && data.description.size() <= 2000))
        && (!changed.hasAny(['tags']) || validTagList(data.tags))
        && (!changed.hasAny(['format', 'dayOfWeek', 'date']) || validSchedule(data))
        && (!changed.hasAny(['time']) || (data.time is string && data.time.matches('^([01]\\d|2[0-3]):[0-5]\\d$')))
        && (!changed.hasAny(['maxCapacity']) || (data.maxCapacity is int && data.maxCapacity >= 1 && data.maxCapacity <= 100))
        && (!changed.hasAny(['area']) || (data.area is string && isHagueArea(data.area)))
        && (!changed.hasAny(['isPublic']) || data.isPublic is bool)
        && (!changed.hasAny(['showMemberContacts']) || data.showMemberContacts is bool)
        && (!changed.hasAny(['pendingUserIds']) || (data.pendingUserIds is list && data.pendingUserIds.size() <= 200 && data.pendingUserIds.size() == data.pendingUserIds.toSet().size()))
        && (!changed.hasAny(['approvedUserIds']) || (data.approvedUserIds is list && data.approvedUserIds.size() == data.approvedUserIds.toSet().size()))
        && (!changed.hasAny(['invitedUserIds']) || (data.invitedUserIds is list && data.invitedUserIds.size() <= 40 && data.invitedUserIds.size() == data.invitedUserIds.toSet().size()))
        && (!changed.hasAny(['skippedDates']) || validSkippedDates(data));
    }

    function isHost() {
      return signedIn() && request.auth.uid == resource.data.hostId;
    }

    function isManagerEditor(studyId) {
      return signedIn()
        && studyExists(studyId)
        && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
        && exists(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid)).data.permissions.canEdit == true;
    }

    function isStudyEditor(studyId) {
      return isHost() || isManagerEditor(studyId);
    }

    function isParticipantManager(studyId) {
      return signedIn()
        && studyExists(studyId)
        && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
        && exists(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid)).data.permissions.canManageParticipants == true;
    }

    function isCoHostManager(studyId) {
      return signedIn()
        && studyExists(studyId)
        && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
        && exists(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid)).data.permissions.canManageCoHosts == true;
    }

    function isCoHostPermissionManager(studyId) {
      return signedIn()
        && studyExists(studyId)
        && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
        && exists(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid)).data.permissions.canManageCoHostPermissions == true;
    }

    function canGrantPermission(studyId, permission) {
      return studyDoc(studyId).hostId == request.auth.uid
        || (
          isCoHostPermissionManager(studyId)
          && get(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid)).data.permissions.grantable[permission] == true
        );
    }

    function hostPreserved() {
      return request.resource.data.hostId == resource.data.hostId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // New list contains every previous uid plus exactly one: the caller.
    function selfAddedTo(previous, next) {
      return previous is list
        && next is list
        && !previous.hasAny([request.auth.uid])
        && next.hasAny([request.auth.uid])
        && next.hasAll(previous)
        && next.size() == previous.size() + 1;
    }

    // New list is the previous list minus exactly the caller.
    function selfRemovedFrom(previous, next) {
      return previous is list
        && next is list
        && previous.hasAny([request.auth.uid])
        && !next.hasAny([request.auth.uid])
        && previous.hasAll(next)
        && previous.size() == next.size() + 1;
    }

    function removesOneFrom(previous, next) {
      return previous is list
        && next is list
        && previous.hasAll(next)
        && previous.size() == next.size() + 1;
    }

    function managerChangesInvites(studyId) {
      return onlyTouched(['invitedUserIds', 'updatedAt'])
        && resource.data.invitedUserIds is list
        && request.resource.data.invitedUserIds is list
        && (
          (
            request.resource.data.invitedUserIds.hasAll(resource.data.invitedUserIds)
            && request.resource.data.invitedUserIds.size() == resource.data.invitedUserIds.size() + 1
          )
          || (
            resource.data.invitedUserIds.hasAll(request.resource.data.invitedUserIds)
            && resource.data.invitedUserIds.size() == request.resource.data.invitedUserIds.size() + 1
          )
        )
        && request.resource.data.invitedUserIds.size() <= 40
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function onlyTouched(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function selfRequestsToJoin(studyId) {
      return signedIn()
        && studyIsListed(resource.data)
        && request.auth.uid != resource.data.hostId
        && !resource.data.approvedUserIds.hasAny([request.auth.uid])
        && !isUidOn(resource.data, 'invitedUserIds')
        && (!exists(/databases/$(database)/documents/studies/$(studyId)/notices/$(request.auth.uid))
          || get(/databases/$(database)/documents/studies/$(studyId)/notices/$(request.auth.uid)).data.type != 'removed')
        && onlyTouched(['pendingUserIds', 'updatedAt'])
        && selfAddedTo(resource.data.pendingUserIds, request.resource.data.pendingUserIds)
        && request.resource.data.pendingUserIds.size() <= 200
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function selfCancelsRequest() {
      return signedIn()
        && onlyTouched(['pendingUserIds', 'updatedAt'])
        && selfRemovedFrom(resource.data.pendingUserIds, request.resource.data.pendingUserIds)
        && request.resource.data.pendingUserIds.size() <= 200
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function selfLeavesGroup() {
      return signedIn()
        && request.auth.uid != resource.data.hostId
        && onlyTouched(['approvedUserIds', 'updatedAt'])
        && selfRemovedFrom(resource.data.approvedUserIds, request.resource.data.approvedUserIds)
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function managerRemovesMember(studyId) {
      return request.auth.uid != resource.data.hostId
        && request.resource.data.approvedUserIds.hasAny([request.auth.uid])
        && onlyTouched(['approvedUserIds', 'updatedAt'])
        && request.resource.data.approvedUserIds is list
        && resource.data.approvedUserIds.hasAll(request.resource.data.approvedUserIds)
        && resource.data.approvedUserIds.size() == request.resource.data.approvedUserIds.size() + 1
        && !request.resource.data.approvedUserIds.hasAny([resource.data.hostId])
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function managerManagesSessions(studyId) {
      return signedIn()
        && studyExists(studyId)
        && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
        && exists(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/studies/$(studyId)/managers/$(request.auth.uid)).data.permissions.canManageSessions == true
        && onlyTouched(['skippedDates', 'updatedAt'])
        && validSkippedDates(request.resource.data)
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function managerApprovesMember(studyId) {
      return onlyTouched(['pendingUserIds', 'approvedUserIds', 'updatedAt'])
        && request.resource.data.pendingUserIds is list
        && request.resource.data.approvedUserIds is list
        && resource.data.pendingUserIds.hasAll(request.resource.data.pendingUserIds)
        && request.resource.data.approvedUserIds.hasAll(resource.data.approvedUserIds)
        && resource.data.pendingUserIds.size() == request.resource.data.pendingUserIds.size() + 1
        && request.resource.data.approvedUserIds.size() == resource.data.approvedUserIds.size() + 1
        && resource.data.pendingUserIds.toSet().difference(request.resource.data.pendingUserIds.toSet())
          == request.resource.data.approvedUserIds.toSet().difference(resource.data.approvedUserIds.toSet())
        && request.resource.data.pendingUserIds.size() <= 200
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function managerDeclinesMember(studyId) {
      return onlyTouched(['pendingUserIds', 'updatedAt'])
        && removesOneFrom(resource.data.pendingUserIds, request.resource.data.pendingUserIds)
        && request.resource.data.pendingUserIds.size() <= 200
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    function managerUpdatesParticipants(studyId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isParticipantManager(studyId)
        && (
          (changed.hasOnly(['pendingUserIds', 'approvedUserIds', 'updatedAt']) && managerApprovesMember(studyId))
          || (changed.hasOnly(['pendingUserIds', 'updatedAt']) && managerDeclinesMember(studyId))
          || (changed.hasOnly(['approvedUserIds', 'updatedAt']) && managerRemovesMember(studyId))
          || (changed.hasOnly(['invitedUserIds', 'updatedAt']) && managerChangesInvites(studyId))
        );
    }

    function selfAcceptsInvite() {
      return signedIn()
        && request.auth.uid != resource.data.hostId
        && isUidOn(resource.data, 'invitedUserIds')
        && selfRemovedFrom(resource.data.invitedUserIds, request.resource.data.invitedUserIds)
        && selfAddedTo(resource.data.approvedUserIds, request.resource.data.approvedUserIds)
        && (
          onlyTouched(['invitedUserIds', 'approvedUserIds', 'updatedAt'])
          || (
            onlyTouched(['invitedUserIds', 'approvedUserIds', 'pendingUserIds', 'updatedAt'])
            && selfRemovedFrom(resource.data.pendingUserIds, request.resource.data.pendingUserIds)
          )
        );
    }

    function selfDeclinesInvite() {
      return signedIn()
        && isUidOn(resource.data, 'invitedUserIds')
        && onlyTouched(['invitedUserIds', 'updatedAt'])
        && selfRemovedFrom(resource.data.invitedUserIds, request.resource.data.invitedUserIds);
    }

    function profileKeys() {
      return [
        'uid',
        'fullName',
        'nameTokens',
        'age',
        'photoURL',
        'bio',
        'profileCompleted',
        'publicProfile',
        'createdAt',
        'updatedAt'
      ];
    }

    function validPhoto(url) {
      return url is string && (
        url.size() == 0
        || (url.size() <= 2000 && url.matches('^https://.+'))
        || (
          url.size() <= 24000
          && url.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        )
      );
    }

    function profileComplete(data) {
      return data.profileCompleted == true
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 80
        && data.age is int
        && data.age >= 1
        && data.age <= 120
        && validPhoto(data.photoURL)
        && data.bio is string
        && data.bio.size() <= 800;
    }

    function profileIncomplete(data) {
      return data.profileCompleted == false
        && data.fullName is string
        && data.fullName.size() <= 80
        && data.age is int
        && data.age >= 0
        && data.age <= 120
        && validPhoto(data.photoURL)
        && data.bio is string
        && data.bio.size() <= 800;
    }

    function validNameTokens(data) {
      return !data.keys().hasAny(['nameTokens'])
        || (data.nameTokens is list && data.nameTokens.size() <= 120);
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasOnly(profileKeys())
        && request.resource.data.uid == uid
        && request.resource.data.publicProfile is bool
        && request.resource.data.publicProfile == request.resource.data.profileCompleted
        && validNameTokens(request.resource.data)
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40
        && (
          (profileComplete(request.resource.data) && hasCompletePrivateContact(uid))
          || profileIncomplete(request.resource.data)
        );
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || (signedIn() && resource.data.publicProfile == true);
      allow list: if signedIn() && resource.data.publicProfile == true;
      allow create: if isOwner(uid) && validProfile(uid);
      allow update: if isOwner(uid)
        && validProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);

      match /private/contact {
        allow get: if isOwner(uid);
        allow list: if false;
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['email', 'phone', 'country', 'city', 'neighbourhood', 'updatedAt'])
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 200
          && (request.auth.token.email == null || request.resource.data.email == request.auth.token.email)
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 16
          && (request.resource.data.phone == '' || request.resource.data.phone.matches('^\\+?[0-9]{8,15}$'))
          && request.resource.data.country is string
          && request.resource.data.country.size() <= 60
          && request.resource.data.city is string
          && request.resource.data.city.size() <= 80
          && request.resource.data.neighbourhood is string
          && request.resource.data.neighbourhood.size() <= 80
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;
        allow delete: if isOwner(uid);
      }
    }

    match /studies/{studyId} {
      allow get, list: if canReadStudy(resource.data);

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.isPublic is bool
        && request.resource.data.invitedUserIds is list
        && request.resource.data.invitedUserIds.size() == 0
        && validPublicStudy(request.resource.data)
        && validTagList(request.resource.data.tags)
        && request.resource.data.pendingUserIds.size() == 0
        && request.resource.data.approvedUserIds.size() == 0;

      allow update: if (
          isStudyEditor(studyId)
          && validStudyUpdate(request.resource.data)
          && (isHost() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingUserIds', 'approvedUserIds', 'invitedUserIds']))
        )
        || selfRequestsToJoin(studyId)
        || selfCancelsRequest()
        || selfLeavesGroup()
        || managerUpdatesParticipants(studyId)
        || managerManagesSessions(studyId)
        || selfAcceptsInvite()
        || selfDeclinesInvite()
        || (
          signedIn()
          && !resource.data.keys().hasAny(['isPublic'])
          && onlyTouched(['isPublic'])
          && request.resource.data.isPublic == true
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
        );

      allow delete: if isHost();

      match /access/members {
        allow get: if studyExists(studyId) && canReadPrivate(studyDoc(studyId));

        allow create, update: if studyExists(studyId)
          && signedIn()
          && request.resource.data.keys().hasOnly(['hostId', 'approvedUserIds'])
          && request.resource.data.hostId is string
          && request.resource.data.hostId == studyDoc(studyId).hostId
          && request.resource.data.approvedUserIds is list
          && request.resource.data.approvedUserIds == studyDoc(studyId).approvedUserIds;

        allow delete: if studyExists(studyId)
          && signedIn()
          && studyDoc(studyId).hostId == request.auth.uid;
      }

      match /managers/{uid} {
        allow read: if studyExists(studyId)
          && signedIn()
          && (studyDoc(studyId).hostId == request.auth.uid
            || studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid]));
        allow create: if studyExists(studyId)
          && signedIn()
          && (studyDoc(studyId).hostId == request.auth.uid || isCoHostManager(studyId))
          && studyDoc(studyId).approvedUserIds.hasAny([uid])
          && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'permissions', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt is string
          && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string)
          && (!request.resource.data.keys().hasAny(['permissions'])
            || (request.resource.data.permissions is map
              && request.resource.data.permissions.keys().hasOnly(['canEdit', 'canManageParticipants', 'canManageCoHosts', 'canManageCoHostPermissions', 'canManageSessions', 'grantable'])
              && (!request.resource.data.permissions.keys().hasAny(['canEdit'])
                || (request.resource.data.permissions.canEdit is bool
                  && (request.resource.data.permissions.canEdit == false || canGrantPermission(studyId, 'canEdit'))))
              && (!request.resource.data.permissions.keys().hasAny(['canManageParticipants'])
                || (request.resource.data.permissions.canManageParticipants is bool
                  && (request.resource.data.permissions.canManageParticipants == false || canGrantPermission(studyId, 'canManageParticipants'))))
              && (!request.resource.data.permissions.keys().hasAny(['canManageCoHosts'])
                || (request.resource.data.permissions.canManageCoHosts is bool
                  && (request.resource.data.permissions.canManageCoHosts == false || canGrantPermission(studyId, 'canManageCoHosts'))))
              && (!request.resource.data.permissions.keys().hasAny(['canManageCoHostPermissions'])
                || (request.resource.data.permissions.canManageCoHostPermissions is bool
                  && (request.resource.data.permissions.canManageCoHostPermissions == false || canGrantPermission(studyId, 'canManageCoHostPermissions'))))
              && (!request.resource.data.permissions.keys().hasAny(['canManageSessions'])
                || (request.resource.data.permissions.canManageSessions is bool
                  && (request.resource.data.permissions.canManageSessions == false || canGrantPermission(studyId, 'canManageSessions'))))
              && (!request.resource.data.permissions.keys().hasAny(['grantable'])
                || (request.resource.data.permissions.grantable is map
                  && request.resource.data.permissions.grantable.keys().hasOnly(['canEdit', 'canManageParticipants', 'canManageSessions', 'canManageCoHosts', 'canManageCoHostPermissions'])
                  && request.resource.data.permissions.grantable.canEdit is bool
                  && (request.resource.data.permissions.grantable.canEdit == false || canGrantPermission(studyId, 'canEdit'))
                  && request.resource.data.permissions.grantable.canManageParticipants is bool
                  && (request.resource.data.permissions.grantable.canManageParticipants == false || canGrantPermission(studyId, 'canManageParticipants'))
                  && request.resource.data.permissions.grantable.canManageSessions is bool
                  && (request.resource.data.permissions.grantable.canManageSessions == false || canGrantPermission(studyId, 'canManageSessions'))
                  && request.resource.data.permissions.grantable.canManageCoHosts is bool
                  && (request.resource.data.permissions.grantable.canManageCoHosts == false || canGrantPermission(studyId, 'canManageCoHosts'))
                  && request.resource.data.permissions.grantable.canManageCoHostPermissions is bool
                  && (request.resource.data.permissions.grantable.canManageCoHostPermissions == false || canGrantPermission(studyId, 'canManageCoHostPermissions'))))));
        allow update: if studyExists(studyId)
          && signedIn()
          && (studyDoc(studyId).hostId == request.auth.uid || (isCoHostPermissionManager(studyId) && uid != request.auth.uid))
          && studyDoc(studyId).approvedUserIds.hasAny([uid])
          && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'permissions', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt is string
          && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string)
          && request.resource.data.permissions is map
          && request.resource.data.permissions.keys().hasOnly(['canEdit', 'canManageParticipants', 'canManageCoHosts', 'canManageCoHostPermissions', 'canManageSessions', 'grantable'])
          && (!request.resource.data.permissions.keys().hasAny(['canEdit']) || (request.resource.data.permissions.canEdit is bool && (request.resource.data.permissions.canEdit == false || canGrantPermission(studyId, 'canEdit'))))
          && (!request.resource.data.permissions.keys().hasAny(['canManageParticipants']) || (request.resource.data.permissions.canManageParticipants is bool && (request.resource.data.permissions.canManageParticipants == false || canGrantPermission(studyId, 'canManageParticipants'))))
          && (!request.resource.data.permissions.keys().hasAny(['canManageCoHosts']) || (request.resource.data.permissions.canManageCoHosts is bool && (request.resource.data.permissions.canManageCoHosts == false || canGrantPermission(studyId, 'canManageCoHosts'))))
          && (!request.resource.data.permissions.keys().hasAny(['canManageCoHostPermissions']) || (request.resource.data.permissions.canManageCoHostPermissions is bool && (request.resource.data.permissions.canManageCoHostPermissions == false || canGrantPermission(studyId, 'canManageCoHostPermissions'))))
          && (!request.resource.data.permissions.keys().hasAny(['canManageSessions']) || (request.resource.data.permissions.canManageSessions is bool && (request.resource.data.permissions.canManageSessions == false || canGrantPermission(studyId, 'canManageSessions'))))
          && (!request.resource.data.permissions.keys().hasAny(['grantable'])
            || (request.resource.data.permissions.grantable is map
              && request.resource.data.permissions.grantable.keys().hasOnly(['canEdit', 'canManageParticipants', 'canManageSessions', 'canManageCoHosts', 'canManageCoHostPermissions'])
              && request.resource.data.permissions.grantable.canEdit is bool
              && request.resource.data.permissions.grantable.canManageParticipants is bool
              && request.resource.data.permissions.grantable.canManageSessions is bool
              && request.resource.data.permissions.grantable.canManageCoHosts is bool
              && request.resource.data.permissions.grantable.canManageCoHostPermissions is bool));
        allow delete: if studyExists(studyId)
          && signedIn()
          && uid != studyDoc(studyId).hostId
          && (studyDoc(studyId).hostId == request.auth.uid || isCoHostManager(studyId));
      }

      match /memberContacts/{uid} {
        allow get: if signedIn()
          && (request.auth.uid == uid || canSeeGroupContact(studyId, uid));
        allow list: if false;
        allow create, update: if studyExists(studyId)
          && signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['phone', 'place', 'updatedAt'])
          && request.resource.data.phone is string
          && (request.resource.data.phone == '' || request.resource.data.phone.matches('^\\+?[0-9]{8,15}$'))
          && request.resource.data.place is string
          && request.resource.data.place.size() <= 240
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /sessions/{date} {
        allow get, list: if studyExists(studyId) && canReadPrivate(studyDoc(studyId));

        allow create, update: if studyExists(studyId)
          && signedIn()
          && (studyDoc(studyId).hostId == request.auth.uid || isManagerEditor(studyId))
          && date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.keys().hasOnly(['description', 'updatedAt'])
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 4000
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40;

        allow delete: if studyExists(studyId)
          && signedIn()
          && (studyDoc(studyId).hostId == request.auth.uid || isManagerEditor(studyId));

        match /attendees/{uid} {
          allow read: if studyExists(studyId) && canReadPrivate(studyDoc(studyId));
          allow create, update, delete: if false;
        }

        match /summary/{summaryId} {
          allow read: if studyExists(studyId) && canReadPrivate(studyDoc(studyId));
          allow create, update, delete: if false;
        }
      }

      match /private/details {
        allow read: if studyExists(studyId) && canReadPrivate(studyDoc(studyId));

        allow create, update: if studyExists(studyId)
          && signedIn()
          && (studyDoc(studyId).hostId == request.auth.uid || isManagerEditor(studyId))
          && request.resource.data.keys().hasOnly(['exactAddress', 'entryNotes', 'updatedAt'])
          && request.resource.data.exactAddress is string
          && request.resource.data.exactAddress.size() > 0
          && request.resource.data.exactAddress.size() <= 180
          && request.resource.data.entryNotes is string
          && request.resource.data.entryNotes.size() <= 1000
          && request.resource.data.updatedAt is string;

        allow delete: if studyExists(studyId)
          && signedIn()
          && studyDoc(studyId).hostId == request.auth.uid;
      }

      match /notices/{uid} {
        allow read: if signedIn() && resource.data.userId == request.auth.uid;

        allow read: if studyExists(studyId)
          && signedIn()
          && studyDoc(studyId).hostId == request.auth.uid;

        allow create, update: if (
            studyExists(studyId)
            && signedIn()
            && uid == request.auth.uid
            && studyDoc(studyId).hostId != request.auth.uid
            && request.resource.data.keys().hasOnly(['type', 'userId', 'createdAt'])
            && (
              (
                request.resource.data.type == 'left'
                && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
              )
              || (
                request.resource.data.type == 'cancelled'
                && studyDoc(studyId).pendingUserIds.hasAny([request.auth.uid])
              )
              || (
                (request.resource.data.type == 'accepted' || request.resource.data.type == 'declined')
                && studyDoc(studyId).keys().hasAny(['invitedUserIds'])
                && (
                  studyDoc(studyId).invitedUserIds.hasAny([request.auth.uid])
                  || (
                    request.resource.data.type == 'accepted'
                    && studyDoc(studyId).approvedUserIds.hasAny([request.auth.uid])
                  )
                )
              )
            )
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() <= 40
          )
          || (
            studyExists(studyId)
            && signedIn()
            && (studyDoc(studyId).hostId == request.auth.uid || isParticipantManager(studyId))
            && uid != request.auth.uid
            && uid != studyDoc(studyId).hostId
            && studyDoc(studyId).approvedUserIds.hasAny([uid])
            && request.resource.data.keys().hasOnly(['type', 'userId', 'createdAt', 'studyTitle', 'hostName'])
            && request.resource.data.type == 'removed'
            && request.resource.data.userId == uid
            && request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() <= 40
            && request.resource.data.studyTitle is string
            && request.resource.data.studyTitle.size() > 0
            && request.resource.data.studyTitle.size() <= 120
            && request.resource.data.hostName is string
            && request.resource.data.hostName.size() > 0
            && request.resource.data.hostName.size() <= 80
          );

        allow delete: if studyExists(studyId)
          && signedIn()
          && (
            studyDoc(studyId).hostId == request.auth.uid
            || request.auth.uid == uid
          );
      }
    }
  }
}
